<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/sportscoutingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="player"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnEditContainer"
            app:layout_constraintHorizontal_bias="0" />

        <TextView
            android:id="@+id/description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="team • position"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            app:layout_constraintStart_toStartOf="@id/sportscoutingTitle"
            app:layout_constraintTop_toBottomOf="@id/sportscoutingTitle"
            app:layout_constraintEnd_toStartOf="@+id/btnEditContainer" />

        <!-- Purple container for the edit button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnEditContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/purplePill"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_edit_24"
                app:tint="@android:color/white"
                android:contentDescription="@string/cd_edit_player" />
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
